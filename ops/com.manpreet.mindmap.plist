<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.manpreet.mindmap</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>REPLACE_WITH_AGENT_MINDMAP_REPO_ROOT/scripts/start-mac.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>REPLACE_WITH_AGENT_MINDMAP_REPO_ROOT</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>MINDMAP_LEDGER</key>
		<string>REPLACE_WITH_ABSOLUTE_PATH_TO_task-ledger.md</string>
		<key>MINDMAP_EVENTS_SOURCE</key>
		<string>gh</string>
		<key>PYTHONPATH</key>
		<string>REPLACE_WITH_AGENT_MINDMAP_REPO_ROOT</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>StandardOutPath</key>
	<string>REPLACE_WITH_ABSOLUTE_LOG_DIR/live.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>REPLACE_WITH_ABSOLUTE_LOG_DIR/live.stderr.log</string>
</dict>
</plist>
