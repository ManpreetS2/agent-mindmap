{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ManpreetS2/agent-mindmap/schema/activity.schema.json",
  "title": "MINDMAP activity snapshot",
  "description": "activity.json: ledger + GitHub ingest output for the agent-activity dashboard. MM-020a: schema_version 1.1.0 adds message edges, required provenance on events (filled for legacy via migrate), optional recipients/groups; 1.0.0 fixtures remain valid on disk and gain provenance through migration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "project",
    "meta",
    "nodes",
    "tasks",
    "events",
    "edges",
    "unparsed"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0", "1.1.0"],
      "description": "1.0.0 legacy fixtures (provenance optional until migrated); 1.1.0 requires provenance on every event"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when this snapshot was written"
    },
    "project": {
      "type": "string",
      "enum": ["fencepost", "agent-mindmap"],
      "description": "MM-020-P0: live builds use resolve_project_name() (typically agent-mindmap); demo fixtures may still use fencepost"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github"],
      "properties": {
        "github": {
          "type": "string",
          "enum": ["ok", "error", "skipped", "rate_limited", "never_run"]
        },
        "ledger": {
          "type": "string",
          "enum": ["ok", "error", "skipped", "demo", "unavailable"],
          "description": "Ledger read status (path or gh data/ledger mirror)"
        },
        "ledger_last_entry_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Latest dated ledger entry timestamp for the stale banner"
        },
        "ledger_error": {
          "type": "string",
          "description": "Human-readable ledger failure when meta.ledger is unavailable or error"
        },
        "events_source": {
          "type": "string",
          "description": "Optional live events source marker (MM-020)"
        },
        "mode": {
          "type": "string",
          "enum": ["demo", "live"],
          "description": "MM-020i: server mode when snapshot was produced (demo fixtures vs live ingest)"
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "unparsed": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" },
      "description": "Ledger lines that could not be fully classified; also mirrored as note events when applicable"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": "1.1.0" } },
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "allOf": [
                { "$ref": "#/$defs/event" },
                { "required": ["provenance"] }
              ]
            }
          },
          "unparsed": {
            "type": "array",
            "items": {
              "allOf": [
                { "$ref": "#/$defs/event" },
                { "required": ["provenance"] }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["IDLE", "IN_PROGRESS", "IN_REVIEW", "BLOCKED", "DONE", "UNKNOWN"]
    },
    "nodeGroup": {
      "type": "string",
      "enum": ["owner", "build", "qr", "radar"]
    },
    "groupId": {
      "type": "string",
      "minLength": 1,
      "description": "Group id; v1 uses owner|build|qr|radar; later groups may be added via config"
    },
    "provenance": {
      "type": "string",
      "enum": ["observed", "agent-reported", "github-verified"]
    },
    "eventType": {
      "type": "string",
      "enum": [
        "assigned",
        "handoff",
        "pr_opened",
        "pr_updated",
        "verdict",
        "merged",
        "blocker",
        "ci",
        "note",
        "unparsed",
        "message"
      ]
    },
    "edgeType": {
      "type": "string",
      "enum": ["handoff", "verdict", "pr", "merge", "message"]
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "CHANGES", "CONDITIONAL", "BLOCKED", "INCONCLUSIVE"]
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "signature",
            "ledger_owner",
            "unknown",
            "github_login",
            "github_login_unmapped"
          ]
        }
      }
    },
    "taskId": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Z]{2,}-[0-9]{3}[A-Za-z0-9]*(-[0-9]+)?$"
        },
        {
          "type": "string",
          "pattern": "^[A-Z]{2,}-[A-Z]{2}[0-9]{3}(-[0-9]+)?$",
          "description": "Backlog ids with embedded task key, e.g. QA-RP004-1"
        }
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "group", "status", "agent_links", "layout"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "group": { "$ref": "#/$defs/nodeGroup" },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/groupId" },
          "description": "Full membership (one identity across groups). Optional on 1.0.0 fixtures."
        },
        "status": { "$ref": "#/$defs/status" },
        "current_task": { "type": "string" },
        "last_activity_ts": {
          "type": "string",
          "format": "date-time"
        },
        "agent_links": {
          "type": "array",
          "items": { "type": "string" }
        },
        "layout": { "$ref": "#/$defs/layout" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "project",
        "owner",
        "status_raw",
        "status",
        "prs",
        "source_url"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/taskId" },
        "title": { "type": "string" },
        "project": { "type": "string" },
        "owner": { "type": "string" },
        "status_raw": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "prs": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "source_url": { "type": "string", "minLength": 1 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "actor",
        "target",
        "task_id",
        "attribution",
        "source_url",
        "source_time",
        "raw"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable id, typically sha1(source + locator)"
        },
        "type": { "$ref": "#/$defs/eventType" },
        "actor": {
          "type": ["string", "null"]
        },
        "target": {
          "type": ["string", "null"]
        },
        "task_id": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/taskId" }]
        },
        "pr": { "type": "integer", "minimum": 1 },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "description": "owner/name; PR joins use (repo, number), never number alone"
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "verdict": {
          "oneOf": [{ "$ref": "#/$defs/verdict" }, { "type": "null" }]
        },
        "attribution": { "$ref": "#/$defs/attribution" },
        "source_url": { "type": "string", "minLength": 1 },
        "source_time": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 with offset; ledger times parsed as America/Los_Angeles"
        },
        "raw": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "recipients": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Explicit recipients only — never invented"
        },
        "group": { "$ref": "#/$defs/groupId" },
        "related_id": {
          "type": ["string", "null"]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "type", "count", "event_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "Bot id, or group:{groupId} for untargeted group messages"
        },
        "type": { "$ref": "#/$defs/edgeType" },
        "count": { "type": "integer", "minimum": 1 },
        "event_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "networkEvent": {
      "type": "object",
      "additionalProperties": false,
      "description": "Live collector / SSE payload (messages model). Not required on activity.json.",
      "required": [
        "id",
        "ts",
        "sender",
        "group",
        "type",
        "summary",
        "provenance"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ts": { "type": "string", "format": "date-time" },
        "sender": { "type": "string", "minLength": 1 },
        "recipients": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Only when explicit — never invented"
        },
        "unknown_recipients": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Explicit recipient ids not found in config/bots.json"
        },
        "group": { "$ref": "#/$defs/groupId" },
        "type": { "type": "string", "minLength": 1 },
        "task_id": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/taskId" }]
        },
        "summary": {
          "type": "string",
          "description": "Sanitized short summary; never raw transcript"
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "related_id": { "type": ["string", "null"] }
      }
    }
  }
}
